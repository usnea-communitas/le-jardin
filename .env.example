# Example environment for Le Jardin. Copy it to .env, which git ignores;
# `vercel dev` loads it, Node scripts with `node --env-file=.env <script>`.
# Nothing here is needed to play, build or test the game: without a Claude
# API key the Living Lesson serves its reviewed offline lessons.

# The Living Lesson (api/garden-reflection.js) asks Claude Haiku 5.5 through
# the Claude API. Use a key from a Claude Console workspace with a monthly
# spend limit; on Vercel the same variable is set for Production and Preview.
ANTHROPIC_API_KEY=

# Only for the catalogue review scripts (scripts/review-*catalog.mjs), which
# still go through Vercel AI Gateway: an AI Gateway key, or the OIDC token
# that `vercel env pull` writes.
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=

# Set to 1 to always serve the offline lesson, even with a key.
LIVING_LESSON_FORCE_FALLBACK=

# Only for regenerating the narration (scripts/generate-audio*.ps1).
ELEVENLABS_API_KEY=
