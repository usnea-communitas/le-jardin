# Example environment for Le Jardin. Copy it to .env, which git ignores;
# `vercel dev` loads it, Node scripts with `node --env-file=.env <script>`.
# Nothing here is needed to play, build or test the game: without an AI
# Gateway credential the Living Lesson serves its reviewed offline lessons.

# Model access for the Living Lesson (api/garden-reflection.js) and the
# catalogue review scripts (scripts/review-*catalog.mjs). On Vercel the
# project's OIDC token is used automatically; `vercel env pull` writes
# VERCEL_OIDC_TOKEN for local use. An AI Gateway key works as well.
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=

# Set to 1 to always serve the offline lesson, even with a credential.
LIVING_LESSON_FORCE_FALLBACK=

# Only for regenerating the narration (scripts/generate-audio*.ps1).
ELEVENLABS_API_KEY=
