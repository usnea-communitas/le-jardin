{
  "name": "le-jardin",
  "private": true,
  "version": "0.83.0",
  "description": "Le Jardin — a story-led educational browser game about designing a living permaculture garden in Menet, France.",
  "license": "MIT",
  "homepage": "https://permaculture-garden.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usnea-communitas/le-jardin.git"
  },
  "bugs": {
    "url": "https://github.com/usnea-communitas/le-jardin/issues"
  },
  "author": "Martin Pazderník",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "generate": "node scripts/build.mjs",
    "check": "node scripts/check.mjs && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:living-lesson": "node scripts/test-living-lesson.mjs && node scripts/test-living-lesson-api.mjs",
    "test:i18n:living-lesson": "node scripts/test-living-lesson-i18n-matrix.mjs",
    "test:e2e:living-lesson": "node scripts/run-local-e2e.mjs scripts/e2e-living-lesson.mjs",
    "test:e2e:resilience": "node scripts/run-local-e2e.mjs scripts/e2e-resilience.mjs",
    "test:e2e:i18n": "node scripts/e2e-i18n.mjs",
    "test:e2e:i18n-surfaces": "node scripts/e2e-i18n-surface-audit.mjs",
    "test:e2e:i18n-surfaces:pl": "node scripts/e2e-i18n-surface-audit.mjs --locale pl",
    "test:e2e:i18n-layout": "node scripts/e2e-i18n-layout-matrix.mjs",
    "test:e2e:responsive": "node scripts/run-local-e2e.mjs scripts/e2e-responsive-platforms.mjs",
    "test:e2e:touch": "node scripts/run-local-e2e.mjs scripts/e2e-touch-placement.mjs",
    "test:e2e:mobile-book": "node scripts/run-local-e2e.mjs scripts/e2e-mobile-book-gates.mjs",
    "test:e2e:resident-state": "node scripts/run-local-e2e.mjs scripts/e2e-resident-state.mjs",
    "test:e2e:pest-balance": "node scripts/run-local-e2e.mjs scripts/e2e-pest-balance.mjs",
    "test:score": "node scripts/test-garden-score.mjs",
    "test": "npm run check && npm run test:i18n && npm run test:living-lesson && npm run test:score",
    "test:e2e:kitchen": "node scripts/run-local-e2e.mjs scripts/e2e-kitchen-seedbank.mjs",
    "test:e2e:v81": "node scripts/run-local-e2e.mjs scripts/e2e-v81-polish.mjs",
    "test:e2e:v82": "node scripts/run-local-e2e.mjs scripts/e2e-v82-economy-resize.mjs",
    "test:e2e:playthrough": "node scripts/run-local-e2e.mjs scripts/e2e-playthrough.mjs",
    "test:e2e:core": "node scripts/run-local-e2e.mjs scripts/e2e-playthrough.mjs scripts/e2e-touch-placement.mjs scripts/e2e-responsive-platforms.mjs scripts/e2e-living-lesson.mjs scripts/e2e-release-audit.mjs"
  },
  "dependencies": {
    "ai": "^7.0.153",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
